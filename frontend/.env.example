# Absolute URL of the Ente Nadu backend API (used as `<base>/api/...`).
# Leave empty when the backend is served same-origin or proxied by Vite
# (dev proxy in vite.config.ts forwards /api to http://localhost:5000).
# For split-host deployments (e.g. Vercel frontend + Render backend), set
# this to the backend's public URL, e.g. https://ente-nadu-api.onrender.com
VITE_API_BASE_URL=