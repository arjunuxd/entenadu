{
  "name": "ente-nadu-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seeds/seed.ts",
    "seed:admin": "tsx src/seeds/seedAdmin.ts",
    "seed:users": "tsx src/seeds/seedUsers.ts",
    "verify:seed": "tsx scripts/verifySeed.mts",
    "verify:auth": "tsx scripts/verifyAuth.mts",
    "verify:bot": "tsx scripts/verifyBot.mts",
    "verify:admin": "tsx scripts/verifyAdmin.mts",
    "verify:authority": "tsx scripts/verifyAuthority.mts",
    "verify:phase6": "tsx scripts/verifyPhase6.mts",
    "typecheck": "tsc --noEmit"
