PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ente-nadu?retryWrites=true&w=majority

# Authentication (JWT)
JWT_SECRET=replace_with_a_random_secret
JWT_EXPIRES_IN=1d

# Development admin seed (dummy values only — real ones belong in your local .env)
SEED_ADMIN_NAME=Ente Nadu Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_this_password

# Development authority-user seed (dummy dev password only)
SEED_DEV_PASSWORD=Password_what_you_give

# Telegram citizen-reporting bot (long polling). Bot starts only when this is set.
# Leave GEMINI_API_KEY / CLOUDINARY_* set too for the full flow; the server still
# runs without them but bot replies will degrade to basic fallback handling.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Gemini model used for understanding (env-controlled; gemini-3.8-flash is the currently supported model)
# GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key
# Cloudinary (photo storage for complaint attachments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret